<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Bill of Entry List -->
    <record id="view_bill_of_entry_list" model="ir.ui.view">
        <field name="name">bill.of.entry.list</field>
        <field name="model">bill.of.entry</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="boe_number"/>
                <field name="boe_date"/>
                <field name="purchase_order_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Bill of Entry Form -->
    <record id="view_bill_of_entry_form" model="ir.ui.view">
        <field name="name">bill.of.entry.form</field>
        <field name="model">bill.of.entry</field>
        <field name="arch" type="xml">
            <form string="Bill of Entry">
                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                            <field name="purchase_order_id"
                                   options="{'no_create': True}"/>
                        </group>

                        <group>
                            <field name="boe_number" readonly="1"/>
                            <field name="boe_date" readonly="1"/>
                        </group>
                    </group>

                    <notebook>

                        <!-- Vendor Bills -->
                        <page string="Vendor Bills">
                            <field name="vendor_bill_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="name" string="Bill Number"/>
                                    <field name="ref" string="Bill Reference"/>
                                    <field name="partner_id" string="Supplier"/>
                                    <field name="invoice_date"/>
                                    <field name="amount_total"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>

                        <!-- Additional Bills -->
                        <page string="Additional Bills">
                            <field name="additional_bill_line_ids">
                                <list editable="bottom">
                                    <field name="invoice_line_id"
                                           string="Invoice Line"
                                           domain="[
                                               ('move_id.move_type', '=', 'in_invoice'),
                                               ('move_id.state', '=', 'posted'),
                                               ('display_type', '=', 'product'),
                                               ('company_id', '=', parent.company_id)
                                           ]"
                                           options="{'no_create': True, 'no_open': True}"/>

                                    <field name="move_id"
                                           string="Vendor Bill"
                                           readonly="1"/>
                                    <field name="vendor_id"
                                           string="Supplier"
                                           readonly="1"/>
                                    <field name="invoice_date"
                                           readonly="1"/>
                                    <field name="invoice_line_name"
                                           string="Description"
                                           readonly="1"/>
                                    <field name="quantity"
                                           readonly="1"/>
                                    <field name="price_unit"
                                           string="Unit Price"
                                           readonly="1"/>
                                    <field name="subtotal"
                                           readonly="1"/>
                                    <field name="account_id"
                                           string="Account"
                                           readonly="1"/>
                                    <field name="percentage"/>
                                    <field name="allocated_amount"
                                           readonly="1"/>
                                    <field name="currency_id"
                                           column_invisible="True"/>
                                </list>
                            </field>
                        </page>

                        <!-- Notes -->
                        <page string="Notes">
                            <field name="notes"/>
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_bill_of_entry" model="ir.actions.act_window">
        <field name="name">Bills of Entry</field>
        <field name="res_model">bill.of.entry</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_bill_of_entry_root"
              name="Import Tracking"
              sequence="50"
              groups="account.group_account_user"/>

    <menuitem id="menu_bill_of_entry"
              name="Bills of Entry"
              parent="menu_bill_of_entry_root"
              action="action_bill_of_entry"
              sequence="10"
              groups="account.group_account_user"/>

</odoo>