<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vehicle List View -->
    <record id="view_expense_vehicle_list" model="ir.ui.view">
        <field name="name">expense.vehicle.list</field>
        <field name="model">expense.vehicle</field>
        <field name="arch" type="xml">
            <list string="Vehicles">
                <field name="vehicle_number"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Vehicle Form View -->
    <record id="view_expense_vehicle_form" model="ir.ui.view">
        <field name="name">expense.vehicle.form</field>
        <field name="model">expense.vehicle</field>
        <field name="arch" type="xml">
            <form string="Vehicle">
                <sheet>
                    <div class="oe_title">
                        <label for="vehicle_number"/>
                        <h1>
                            <field name="vehicle_number"/>
                        </h1>
                    </div>

                    <group>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vehicle Action -->
    <record id="action_expense_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">expense.vehicle</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Vehicle Configuration Menu -->
    <menuitem
        id="menu_expense_vehicle"
        name="Vehicles"
        parent="hr_expense.menu_hr_expense_configuration"
        action="action_expense_vehicle"
        sequence="30"
        groups="base.group_user"
    />

</odoo>
