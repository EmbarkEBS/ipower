<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_hr_expense_form_paid_by_company"
            model="ir.ui.view">

        <field name="name">
            hr.expense.form.paid.by.company
        </field>

        <field name="model">hr.expense</field>

        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='payment_mode']"
                   position="attributes">

                <attribute name="readonly">1</attribute>

            </xpath>

        </field>

    </record>

</odoo>