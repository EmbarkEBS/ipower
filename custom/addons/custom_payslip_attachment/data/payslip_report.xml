<odoo>
    <record id="action_custom_payslip" model="ir.actions.report">
        <field name="name">Custom Payslip</field>
        <field name="model">hr.payslip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_payslip_report.custom_payslip_template</field>
        <field name="report_file">custom_payslip_report.custom_payslip_template</field>
        <field name="print_report_name">
            'Payslip - %s' % (object.employee_id.name)
        </field>
        <field name="attachment" eval="False"/>
        <field name="attachment_use" eval="False"/>
    </record>
</odoo>
