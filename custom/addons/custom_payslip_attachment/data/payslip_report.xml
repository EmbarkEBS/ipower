<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_payroll.action_report_payslip"
            model="ir.actions.report">

        <!-- Keep the standard Payslip Print action -->
        <field name="name">Payslip</field>

        <!-- Use your custom QWeb template -->
        <field name="report_name">
            custom_payslip_report.custom_payslip_template
        </field>

        <field name="report_file">
            custom_payslip_report.custom_payslip_template
        </field>

        <!-- Do not use a cached report attachment -->
        <field name="attachment" eval="False"/>
        <field name="attachment_use" eval="False"/>

    </record>
</odoo>