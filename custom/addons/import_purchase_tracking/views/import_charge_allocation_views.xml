<odoo>
    <record id="view_import_charge_allocation_list" model="ir.ui.view">
        <field name="name">import.charge.allocation.list</field>
        <field name="model">import.charge.allocation</field>
        <field name="arch" type="xml">
            <list string="Import Charge Allocations">
                <field name="date"/>
                <field name="boe_id"/>
                <field name="bill_number"/>
                <field name="bill_supplier_id"/>
                <field name="move_line_id"/>
                <field name="account_id"/>
                <field name="purchase_order_id"/>
                <field name="po_supplier_id"/>
                <field name="charge_type"/>
                <field name="amount" sum="Allocated Total"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_import_charge_allocation_form" model="ir.ui.view">
        <field name="name">import.charge.allocation.form</field>
        <field name="model">import.charge.allocation</field>
        <field name="arch" type="xml">
            <form string="Import Charge Allocation">
                <sheet>
                    <group>
                        <group>
                            <field name="boe_id"/>
                            <field name="move_line_id"
                                   domain="[('move_id.import_boe_id', '=', boe_id), ('move_id.state', '!=', 'cancel')]"/>
                            <field name="move_id" readonly="1"/>
                            <field name="bill_supplier_id" readonly="1"/>
                            <field name="account_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="purchase_order_id"/>
                            <field name="po_supplier_id" readonly="1"/>
                            <field name="charge_type"/>
                            <field name="amount"/>
                            <field name="company_currency_id" invisible="1"/>
                            <field name="move_line_balance" readonly="1"/>
                            <field name="state" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_import_charge_allocation" model="ir.actions.act_window">
        <field name="name">Charge Allocations</field>
        <field name="res_model">import.charge.allocation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
