<odoo>
    <record id="view_move_form_import_boe" model="ir.ui.view">
        <field name="name">account.move.form.import.boe</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="import_boe_id"
                       invisible="move_type not in ('in_invoice', 'in_refund')"
                       domain="[('company_id', '=', company_id)]"/>
                <field name="boe_number" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
